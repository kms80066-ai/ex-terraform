# variable "변수명" {
#   description = "value"
#   type        = string | number | bool
#   default     = "value"
# }

# output "출력명" {
#   description = "설명"
#   value       = "출력값"
# }

variable "region" {
  description = "AWS Region"
  type        = string
  default     = "ca-central-1"
}

# list(Type) : 중복 가능한 여러 데이터를 저장할 수 있는 변수
# set(Type) : 중복 불가능한 여러 데이터를 저장할 수 있는 변수
variable "subnet_cidr" {
  description = "AWS subnet CIDR"
  type        = list(list(string))
  default = [
    ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"],
    ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]
  ]
}

# map(Type) : key-value 쌍으로 데이터를 저장할 수 있는 변수
variable "tags" {
  description = "AWS Tags"
  type        = map(string)
  default = {
    Name       = "Terraform-Example"
    Enviroment = "Dev"
  }
}

# list(map(Type)) : 중복 가능한 여러 key-value 쌍으로 데이터를 저장
variable "subnet_info" {
  description = "AWS Subnet Info"
  type        = list(map(string))
  default = [
    {
      Name = "subnet-1"
      cidr = "10.0.1.0/24"
    },
    {
      Name = "subnet-2"
      cidr = "10.0.2.0/24"
    }
  ]
}
# ===================================
# 구조체: Tuple / Object
# Tuple : - 데이터 유형을 순서대로 정의   - 데이터 유형 순서대로 데이터를 정의
variable "tup" {
  description = "tuple"
  type        = tuple([string, number, number, number])
  default = [
    "홍길동", 100, 90, 80
  ]
}

# Object : 여러 자료형의 데이터를 맵 형태로 저장
# 권장 사항은 default 선언을 하나 이상 할 것
# variable "obj" {
#   description = "object"
#   type = object({
#     vpc_id   = string
#     vpc_cidr = string
#     tags     = map(string)
#   })
#   default = {
#     vpc_id   = ""
#     vpc_cidr = ""
#     tags     = {}
#   }
# }

variable "obj" {
  description = "object"
  type = object({
    vpc_id   = optional(string,"")
    vpc_cidr = optional(string,"")
  })
  default = {
    vpc_id   = ""
    vpc_cidr = ""
  }
}
# ===================================
output "region" {
  description = "AWS Region"
  value       = var.region
}

output "subnet_cidr" {
  description = "AWS subnet CIDR"
  value       = var.subnet_cidr
}

output "tags" {
  description = "AWS Tags"
  value       = var.tags
}

output "subnet_info" {
  description = "AWS Subnet Info"
  value       = var.subnet_info
}

output "tup" {
  description = "tuple"
  value       = var.tup
}
